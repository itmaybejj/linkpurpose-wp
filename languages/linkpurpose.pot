#: src/Settings/Schema.php:360
msgid "CSS selector"
msgstr ""

#: src/Settings/Schema.php:367
msgid "Visually hide the icon on these links"
msgstr ""

#: src/Settings/Schema.php:368
msgid "CSS selector, e.g. <code><em>.card a</em></code><br>When context makes the link's purpose visually obvious, the icon can be visibly hidden using this setting or your CSS: <code><em>.card .link-purpose-icon { display: none; }</em></code>"
msgstr ""

#: src/Settings/Schema.php:373
msgid "Visually hide icons on links with images by default"
msgstr ""

#: src/Settings/Schema.php:374
msgid "When enabled, you will need to write CSS to <strong>reveal</strong> the icon span (<code>.link-purpose-icon</code>) on links containing <code>img, svg</code> or <code>figure</code> tags.<br>This is not recommended on new sites: noticing and hiding redundant icons is much less error-prone than noticing and revealing missing icons."
msgstr ""

#: src/Settings/Schema.php:380
msgid "Ignore these links entirely"
msgstr ""

#: src/Settings/Schema.php:381
msgid "Only use when machine-readable context or the text of the link itself makes the text of the screen reader hint redundant.<br>Links in the admin bar (<code><em>#wpadminbar a</em></code>) are always ignored.<br>E.g.: <code><em>#external-links-list a, .in-the-news a</em></code>."
msgstr ""

#: src/Settings/Schema.php:400
msgid "Do not prevent line breaks between last word and icon for these links"
msgstr ""

#: src/Settings/Schema.php:401
msgid "Only recommended if issues with gaps or overflow cannot be fixed in the theme; this makes it likely the icon falls to the next line. Set to \"a\" to disable the behavior altogether; otherwise provide exact matches: <code><em>#child-select a, .direct-select</em></code>."
msgstr ""

#: src/Settings/Schema.php:407
msgid "Insert icon outside of these hidden spans"
msgstr ""

#: src/Settings/Schema.php:409
msgid "Prevents icons from being visually hidden if links already contain screen-reader-only text.<br>Default: <code><em>.screen-reader-text, .sr-only, .visually-hidden</em></code>"
msgstr ""

#: src/Settings/Schema.php:415
msgid "Mark links inside this shadow DOM"
msgstr ""

#: src/Settings/Schema.php:416
msgid "<em>Most sites do not have Web components and can ignore this setting.</em><br>E.g.: <code><em>custom-tag-tab-widget, .shadow-embed</em></code>"
msgstr ""

#: src/Settings/Schema.php:422
msgid "Do not mark any links if elements are detected"
msgstr ""

#: src/Settings/Schema.php:423
msgid "Disables the plugin on the page, e.g. while a front-end page builder is active.<br>Default: <code><em>.elementor-editor-active, .wp-customizer-unloading</em></code>"
msgstr ""

#: src/Settings/Schema.php:429
msgid "Do not mark any links if elements are absent"
msgstr ""

#: src/Settings/Schema.php:435
msgid "Attach library then stop; theme will mark links"
msgstr ""

#: src/Settings/Schema.php:436
msgid "Set if you want to preprocess the options object in theme or plugin JS, e.g. to add additional link categories or use custom SVG icons.<br>Your theme will need its own copy of <em>linkpurpose-wp.js</em> that reads <em>window.linkpurposeSettings</em> and initializes the library. Most sites can instead define a <em>window.linkPurposeOptions</em> callback, which receives the built options object before the library starts."
msgstr ""

